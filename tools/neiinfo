#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -lt 1 ]]; then
  echo "usage: $0 <file.ntf> [--json] [--no-tres] [--no-color]" >&2
  exit 2
fi

"$ROOT_DIR/gradlew" -q installDist
exec "$ROOT_DIR/build/install/imaging-nitf-nei/bin/imaging-nitf-nei" "$@"
